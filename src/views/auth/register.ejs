<%- include('../layout/page-start', { title: 'Registrácia', bodyClass: 'page--auth' }) %>

<section class="auth-shell page-enter">
  <aside class="auth-side">
    <div class="ornament" aria-hidden="true"></div>
    <div style="position:relative">
      <a class="brand brand--image" href="/" aria-label="Tichá voda">
        <img src="/images/ui/logo.png" alt="Tichá voda" class="brand-logo brand-logo--auth brand-logo--light" />
        <img src="/images/ui/logo-dark.png" alt="" aria-hidden="true" class="brand-logo brand-logo--auth brand-logo--dark" />
      </a>
      <h1 class="auth-art-title"><span class="glow">Nový</span><br />zápis v almanachu.</h1>
      <p class="auth-art-copy">Pripoj sa k tým, čo zachytávajú svetové vody, revíry a úlovky čierne na bielom.</p>
    </div>
    <div class="auth-art-meta"><span>NODE</span><span>·</span><span>EXPRESS</span><span>·</span><span>MYSQL</span></div>
  </aside>

  <form method="POST" action="/registracia" class="auth-form form-stack" novalidate>
    <span class="mono">REGISTRÁCIA</span>
    <h2>Vytvor si účet</h2>
    <% if (error) { %><div class="flash error static-flash"><span class="dot"></span><%= error %></div><% } %>
    <div class="field">
      <label>Meno a priezvisko</label>
      <input class="input" type="text" name="name" required minlength="2" value="<%= formData.name || '' %>" placeholder="Jozef Mrázik" />
    </div>
    <div class="field">
      <label>E-mail</label>
      <input class="input" type="email" name="email" required autocomplete="email" value="<%= formData.email || '' %>" placeholder="rybar@tichavoda.sk" />
    </div>
    <div class="field">
      <label>Heslo</label>
      <input class="input" type="password" name="password" required minlength="8" autocomplete="new-password" placeholder="••••••••" />
      <span class="hint">Aspoň 8 znakov, jedno veľké, jedno malé a jedno číslo.</span>
    </div>
    <div class="field">
      <label>Heslo ešte raz</label>
      <input class="input" type="password" name="passwordConfirm" required minlength="8" autocomplete="new-password" placeholder="••••••••" />
    </div>
    <button class="btn btn-primary btn-block" type="submit">Vytvoriť účet →</button>
    <div class="row between auth-switch">
      <span>Už máš účet?</span>
      <a href="/prihlasenie">Prihlás sa →</a>
    </div>
  </form>
</section>

<%- include('../layout/page-end') %>
