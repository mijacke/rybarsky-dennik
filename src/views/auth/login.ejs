<%- include('../layout/page-start', { title: 'Prihlásenie', bodyClass: 'page--auth' }) %>

<section class="auth-shell page-enter">
  <aside class="auth-side">
    <div class="ornament" aria-hidden="true"></div>
    <div style="position:relative">
      <a class="brand brand--image" href="/" aria-label="Tichá voda">
        <img src="/images/ui/logo.png" alt="Tichá voda" class="brand-logo brand-logo--auth brand-logo--light" />
        <img src="/images/ui/logo-dark.png" alt="" aria-hidden="true" class="brand-logo brand-logo--auth brand-logo--dark" />
      </a>
      <h1 class="auth-art-title"><span class="glow">Hlboko</span><br />pod hladinou.</h1>
      <p class="auth-art-copy">Prihlás sa, otvor denník, zapíš úlovok. Tichá voda registruje každý záber.</p>
    </div>
    <div class="auth-art-meta"><span>SLOVENSKO</span><span>·</span><span>REVÍRY</span><span>·</span><span>ÚLOVKY</span></div>
  </aside>

  <form method="POST" action="/prihlasenie" class="auth-form form-stack" novalidate>
    <span class="mono">PRIHLÁSENIE</span>
    <h2>Vitaj späť</h2>
    <% if (error) { %><div class="flash error static-flash"><span class="dot"></span><%= error %></div><% } %>
    <div class="field">
      <label>E-mail</label>
      <input class="input" type="email" name="email" required autocomplete="email" value="<%= formData.email || '' %>" placeholder="rybar@tichavoda.sk" />
    </div>
    <div class="field">
      <label>Heslo</label>
      <input class="input" type="password" name="password" required autocomplete="current-password" placeholder="••••••••" />
    </div>
    <button class="btn btn-primary btn-block" type="submit">Prihlásiť sa →</button>
    <div class="row between auth-switch">
      <span>Si tu prvýkrát?</span>
      <a href="/registracia">Vytvor si účet →</a>
    </div>
  </form>
</section>

<%- include('../layout/page-end') %>
