<%- include('../layout/page-start', { title: spot.name, bodyClass: 'page--detail' }) %>

<article class="container section page-enter">
  <a href="/revires" class="mono back-link">← REVÍRY / <%= spot.name.toUpperCase() %></a>

  <div class="detail-hero">
    <div class="img">
      <% if (spot.image_location) { %><img src="<%= spot.image_location %>" alt="<%= spot.name %>" /><% } else { %><img src="/images/ui/home-river.png" alt="" /><% } %>
    </div>
    <div class="veil"></div>
    <div class="content">
      <div class="row gap-sm wrap" style="margin-bottom:12px">
        <span class="chip chip-cyan"><%= spot.water_type_name %></span>
        <span class="chip"><%= spot.region %></span>
        <span class="chip"><%= spot.city %></span>
      </div>
      <h1><%= spot.name %></h1>
      <div class="meta">
        <span><%= spot.author_name %></span>
        <span><%= new Date(spot.created_at).toLocaleDateString('sk-SK') %></span>
        <span><%= spot.catches_count %> úlovkov</span>
        <% if (spot.avg_rating) { %><span>★ <%= Number(spot.avg_rating).toFixed(1) %></span><% } %>
      </div>
    </div>
  </div>

  <div class="detail-grid">
    <div class="col" style="gap:24px">
      <div class="glass" style="padding:28px">
        <span class="mono">POPIS REVÍRU</span>
        <p class="detail-copy"><%= spot.description %></p>
      </div>

      <% if (spot.gps_lat && spot.gps_lon) { %>
        <div class="glass" style="padding:28px">
          <span class="mono">LOKALIZÁCIA</span>
          <div id="spotMap" class="detail__map" data-lat="<%= spot.gps_lat %>" data-lon="<%= spot.gps_lon %>" data-name="<%= spot.name %>"></div>
        </div>
      <% } %>

      <section class="glass catches"
        style="padding:28px"
        data-spot-id="<%= spot.id %>"
        data-current-user-id="<%= user ? user.id : '' %>"
        data-is-admin="<%= isAdmin ? '1' : '' %>">
        <div class="row between wrap" style="margin-bottom:20px">
          <div>
            <span class="mono">DENNÍK ÚLOVKOV</span>
            <h3 style="margin-top:6px">Úlovky z <%= spot.name %></h3>
          </div>
          <% if (!user) { %><a href="/prihlasenie" class="btn btn-ghost btn-sm">Prihlás sa</a><% } %>
        </div>

        <% if (user) { %>
          <form id="catchForm" class="catch-form form-stack" enctype="multipart/form-data">
            <div class="field-row">
              <div class="field">
                <label>Druh ryby</label>
                <input class="input" type="text" name="species" required placeholder="napr. Šťuka severná" />
              </div>
              <div class="field">
                <label>Hmotnosť (kg)</label>
                <input class="input" type="number" step="0.01" min="0" name="weight_kg" required />
              </div>
            </div>
            <div class="field-row">
              <div class="field">
                <label>Dĺžka (cm)</label>
                <input class="input" type="number" step="0.1" min="0" name="length_cm" required />
              </div>
              <div class="field">
                <label>Hodnotenie</label>
                <select class="select" name="rating">
                  <% for (let r = 5; r >= 1; r--) { %><option value="<%= r %>"><%= '★'.repeat(r) %></option><% } %>
                </select>
              </div>
            </div>
            <div class="field">
              <label>Komentár</label>
              <textarea class="textarea" name="comment" rows="2" placeholder="Pár slov k chytaniu..."></textarea>
            </div>
            <div class="field">
              <label>Foto úlovku (voliteľné)</label>
              <input class="input" type="file" name="photo" accept="image/*" />
            </div>
            <div class="row between wrap">
              <button type="submit" class="btn btn-primary btn-sm">Zapísať úlovok</button>
              <p class="catch-form__msg" id="catchFormMsg"></p>
            </div>
          </form>
        <% } %>

        <ul id="catchList" class="catch-list" aria-live="polite"></ul>
      </section>
    </div>

    <aside class="col" style="gap:16px">
      <div class="glass sidebar-card">
        <span class="mono">LOKALIZÁCIA</span>
        <div>
          <div class="kv"><span class="k">Kraj</span><span class="v"><%= spot.region %></span></div>
          <div class="kv"><span class="k">Mesto</span><span class="v"><%= spot.city %></span></div>
          <div class="kv"><span class="k">GPS</span><span class="v"><%= spot.gps_lat || '—' %>, <%= spot.gps_lon || '—' %></span></div>
          <div class="kv"><span class="k">Typ</span><span class="v"><%= spot.water_type_name %></span></div>
        </div>
      </div>

      <% if (user) { %>
        <div class="glass sidebar-card">
          <span class="mono">AKCIE</span>
          <button id="favBtn" class="btn btn-ghost btn-block <%= isFavorite ? 'is-fav' : '' %>" data-spot-id="<%= spot.id %>">
            <span class="fav-on">★ V obľúbených</span>
            <span class="fav-off">☆ Pridať do obľúbených</span>
          </button>
          <% if (user.id === spot.user_id || isAdmin) { %>
            <a href="/revires/<%= spot.id %>/edit" class="btn btn-ghost btn-block">Upraviť revír</a>
            <button class="btn btn-danger btn-block" data-modal-open="deleteSpot">Vymazať revír</button>
          <% } %>
        </div>
      <% } %>

      <div class="glass sidebar-card">
        <span class="mono">TOP ÚLOVKY</span>
        <% if (topCatches.length) { %>
          <% topCatches.forEach(function(c, i){ %>
            <div class="kv"><span class="k">№<%= i + 1 %> <%= c.species %></span><span class="v"><%= c.weight_kg %> kg</span></div>
          <% }) %>
        <% } else { %>
          <p class="empty-inline">Tichá voda. Zatiaľ žiadny úlovok.</p>
        <% } %>
      </div>

      <div class="glass sidebar-card">
        <span class="mono">ŠTATISTIKY</span>
        <div>
          <div class="kv"><span class="k">Úlovkov spolu</span><span class="v"><%= spot.catches_count %></span></div>
          <div class="kv"><span class="k">Priemer ★</span><span class="v"><%= spot.avg_rating ? Number(spot.avg_rating).toFixed(1) : '—' %></span></div>
        </div>
      </div>
    </aside>
  </div>
</article>

<% if (user) { %>
  <div class="modal-layer" id="modal-editCatch" hidden>
    <div class="modal-backdrop" data-modal-close></div>
    <div class="modal modal-wide">
      <div class="row between" style="margin-bottom:6px">
        <span class="mono">Úprava úlovku</span>
        <button type="button" class="icon-btn" data-modal-close aria-label="Zatvoriť">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M6 6l12 12M18 6l-12 12"/></svg>
        </button>
      </div>
      <h3 id="editCatchTitle" style="margin-bottom:18px">Upraviť úlovok</h3>
      <form id="editCatchForm" class="form-stack">
        <div class="field-row">
          <div class="field">
            <label for="ec_species">Druh ryby</label>
            <input class="input" type="text" id="ec_species" name="species" required />
          </div>
          <div class="field">
            <label for="ec_weight">Hmotnosť (kg)</label>
            <input class="input" type="number" step="0.01" min="0" id="ec_weight" name="weight_kg" required />
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="ec_length">Dĺžka (cm)</label>
            <input class="input" type="number" step="0.1" min="0" id="ec_length" name="length_cm" required />
          </div>
          <div class="field">
            <label for="ec_rating">Hodnotenie</label>
            <select class="select" id="ec_rating" name="rating">
              <% for (let r = 5; r >= 1; r--) { %><option value="<%= r %>"><%= '★'.repeat(r) %> (<%= r %>)</option><% } %>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="ec_comment">Komentár</label>
          <textarea class="textarea" id="ec_comment" name="comment" rows="3" placeholder="Pár slov k chytaniu..."></textarea>
        </div>
        <p class="catch-form__msg" id="editCatchMsg"></p>
        <div class="row gap-sm" style="justify-content:flex-end;margin-top:8px">
          <button type="button" class="btn btn-ghost" data-modal-close>Zrušiť</button>
          <button type="submit" class="btn btn-primary">Uložiť zmeny</button>
        </div>
      </form>
    </div>
  </div>
<% } %>

<% if (user && (user.id === spot.user_id || isAdmin)) { %>
  <div class="modal-layer" id="modal-deleteSpot" hidden>
    <div class="modal-backdrop" data-modal-close></div>
    <div class="modal">
      <span class="mono" style="color:var(--danger)">POTVRDIŤ ZMAZANIE</span>
      <h3 style="margin-top:8px">Vymazať revír „<%= spot.name %>"?</h3>
      <p style="color:var(--ink-soft);font-size:14px;margin-top:8px">Táto akcia je nevratná. Vymažú sa aj všetky úlovky a obľúbené odkazy.</p>
      <form method="POST" action="/revires/<%= spot.id %>/delete" class="row gap-sm" style="margin-top:24px;justify-content:flex-end">
        <button type="button" class="btn btn-ghost" data-modal-close>Zrušiť</button>
        <button type="submit" class="btn btn-danger">Áno, vymazať</button>
      </form>
    </div>
  </div>
<% } %>

<%
  const detailScripts = ['/js/modal.js', '/js/favorites.js', '/js/catches.js'];
  if (spot.gps_lat && spot.gps_lon) {
    detailScripts.unshift('/js/leaflet-init.js');
  }
%>
<% if (spot.gps_lat && spot.gps_lon) { %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<% } %>

<%- include('../layout/page-end', { scripts: detailScripts }) %>
