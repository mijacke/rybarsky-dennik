<%- include('../layout/page-start', { title: '500 — Chyba', bodyClass: 'page--error' }) %>
<section class="err-shell page-enter">
  <div class="glass err-card">
    <div class="err-code">500</div>
    <h2>Niečo sa zlomilo</h2>
    <p style="color:var(--ink-soft);margin-top:14px;font-size:16px;max-width:44ch;margin-inline:auto">Server stratil prút. Skús to o chvíľu znova.</p>
    <% if (typeof message !== 'undefined') { %><p class="mono" style="margin-top:16px"><%= message %></p><% } %>
    <div class="row gap-sm" style="margin-top:32px;justify-content:center">
      <a href="/" class="btn btn-primary">Domov →</a>
      <a href="/revires" class="btn btn-ghost">Revíry</a>
    </div>
  </div>
</section>
<%- include('../layout/page-end') %>
